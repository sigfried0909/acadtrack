
# =========================================
# DATABASE AND ENVIRONMENT CONFIGURATION
# =========================================
/.env
/.env.*
!/.env.example

/config/database.local.php
/config/database.production.php

# =========================================
# STUDENT PERMIT DOCUMENTS
# =========================================
/storage/permits/*
!/storage/permits/.gitkeep
!/storage/permits/.htaccess

# =========================================
# PROFILE PICTURES
# =========================================
/uploads/profile_pictures/*
!/uploads/profile_pictures/.gitkeep

# =========================================
# LOGS AND BACKUPS
# =========================================
/storage/logs/
/backups/
*.log
*.bak
*.sql
*.sql.gz

# =========================================
# LOCAL DEVELOPMENT FILES
# =========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
